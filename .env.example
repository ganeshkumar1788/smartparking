# --- Root Monorepo Environment Variables ---

# MongoDB (Required for Backend)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smartpark

# JWT (Required for Backend)
JWT_SECRET=your_super_secret_jwt_key

# Firebase (Required for Auth in Backend)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Frontend
# In Vercel production, set this to /api
NEXT_PUBLIC_API_URL=/api

# Others
PLATFORM_COMMISSION_PERCENT=10
CLIENT_URL=https://your-smartpark-deployment.vercel.app
